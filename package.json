{
  "name": "tripwire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate && concurrently -k -n web,worker,chaos -c blue,magenta,yellow \"next dev\" \"npm:worker:dev\" \"npm:chaos\"",
    "build": "next build",
    "start": "npm run db:migrate && concurrently -k -n web,worker -c blue,magenta \"next start\" \"npm:worker\"",
    "worker": "cross-env NODE_ENV=production node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "worker:dev": "cross-env NODE_ENV=development tsx watch --env-file-if-exists=.env.local src/worker/index.ts",
    "chaos": "node --import tsx chaos/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "landing:assets": "cross-env NODE_ENV=development node --import tsx scripts/landing-assets.ts",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run --coverage src",
    "test:e2e": "node --import tsx tests/e2e/flow.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@libsql/client": "^0.18.0",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
