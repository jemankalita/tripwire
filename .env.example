# Copy to .env.local and fill in what you need. Everything is optional for local dev.

# Public URL of the web app (used in alert links and RSS feeds)
APP_URL=http://localhost:3000

# SQLite file by default. Point at Turso/libsql for a hosted database.
# DATABASE_URL=file:./data/tripwire.db
# DATABASE_AUTH_TOKEN=

# Where screenshots are stored (content-addressed)
# BLOB_DIR=./data/blobs

# Allow watching localhost / private IPs — ONLY for the local chaos demo. Ignored in production.
TRIPWIRE_ALLOW_PRIVATE=0

# Delay before the confirmation render that must reproduce a change (ms)
CONFIRM_DELAY_MS=60000
# Parallel headless renders, and minimum gap between renders on the same host (ms)
CHECK_CONCURRENCY=3
DOMAIN_GAP_MS=10000
# Set to 0 to ignore robots.txt (not recommended)
RESPECT_ROBOTS=1

# One-line AI summaries (Claude). Defaults to claude-opus-5-5.
# ANTHROPIC_API_KEY=
# CLAUDE_SUMMARY_MODEL=claude-opus-5-5

# Email over HTTPS via Resend (works on Railway, which blocks SMTP on Trial/Hobby plans)
# Free key at https://resend.com — without a verified domain it sends from onboarding@resend.dev
# to your own Resend account email.
# RESEND_API_KEY=

# Email via SMTP (otherwise emails only appear in the in-app Inbox)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Tripwire <alerts@example.com>"

# Telegram alerts: create a bot with @BotFather
# TELEGRAM_BOT_TOKEN=
